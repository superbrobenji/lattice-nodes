# ESP-IDF default configuration for lattice-nodes firmware
# Approach: arduino-esp32 as IDF component (spec §Phase 0)

# Arduino-as-component: provides app_main() that calls setup()/loop()
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
# Phase I Task 6 (item II): 8192 -> 4096. Real-hardware
# uxTaskGetStackHighWaterMark() measurement wasn't available from this
# worktree (no flashable device), so this is a compile-time estimate instead
# of Step 6's live measurement — see task-6-report.md "Stack sizing rationale"
# for the -fstack-usage-verified per-function frame sizes behind it. Deepest
# verified loop-task call chain (master forwarding a route report to serial:
# loop -> Mesh::loop -> drainRecvQueue -> processRouteReport -> onMeshData ->
# SerialAdapter::onMeshDataImpl -> SerialFraming::encode) sums to ~1.4 KB of
# firmware-code stack frames, leaving >2.5 KB of the new 4096 B budget
# unaccounted for by vendored library internals (libsodium, ESP-NOW,
# nvs_flash, uart driver) not covered by -fstack-usage in this analysis.
# Recommend confirming with a live uxTaskGetStackHighWaterMark() reading at
# the next hardware-in-loop opportunity before this ships to a production
# fleet.
CONFIG_ARDUINO_LOOP_STACK_SIZE=4096

# Flash: optimize for size + link-time optimization (Phase G §2, issue #52 lever 2).
# gc-sections + function-sections are ESP-IDF defaults already.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_LTO=y

# Partition table (no EEPROM partition — NVS replaces it)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: disabled — unused, saves ~10KB flash + heap
CONFIG_BT_ENABLED=n

# Phase I Task 2 (item GG): mbedtls fully dropped from E2E crypto — E2ECrypto.h,
# MeshCrypto.h, and RouteMac.h now call libsodium exclusively (see
# firmware/main/idf_component.yml's espressif/libsodium dependency), so the
# CHACHA20/POLY1305/CHACHAPOLY/HKDF/HARDWARE_SHA tuning that only existed for
# those call sites is gone. CONFIG_MBEDTLS_AES_C/GCM_C/CCM_C/HARDWARE_AES/
# TLS_ENABLED below are a SEPARATE, pre-existing Phase G/Phase A size trim
# (this node has no TLS/HTTPS use at all, independent of which library E2E
# crypto happens to call) — those stay =n. Measured: dropping them too (i.e.
# deleting this whole block, matching the Task 2 brief's Step 13 literally)
# silently re-enables mbedTLS's TLS stack + AES/GCM/CCM by falling back to
# ESP-IDF's default (=y for all five), a +82KB regression relative to the
# pre-Task-2 baseline (measured via a real mbedtls-linked build of this exact
# tree) that has nothing to do with this task's E2E-crypto swap — see task
# report.
CONFIG_MBEDTLS_AES_C=n
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_TLS_ENABLED=n

# ESP-NOW and WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# NVS Flash
CONFIG_NVS_ENCRYPTION=n

# Task watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Phase I Task 1: log + WiFi trim (item LL + audit XX-AAA)
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ESP-NOW is our only WiFi use: no AP association, no aggregation, no persisted creds
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n

# LWIP: no sockets used; disable TCP + UDP if arduino-esp32 WiFi.mode allows it.
# NOTE: If Task 1 build fails with these, comment them out and leave a TODO to
# re-enable them at Task 3 (which replaces WiFi.mode with raw esp_netif_new).
CONFIG_LWIP_TCP_ENABLED=n
CONFIG_LWIP_UDP_ENABLED=n

# Phase I Task 2 follow-up: disable WiFi Enterprise to break the
# esp_wifi -> MBEDTLS_TLS_ENABLED force-select chain (no AP association in
# this firmware; pure ESP-NOW). LIBSODIUM_USE_MBEDTLS_SHA=y kept at default
# — measured: routing libsodium SHA through mbedtls's HW-accelerated SHA256
# is ~3KB smaller than libsodium's portable SHA256 impl (mbedtls is linked
# anyway for esp_wifi's WPA/PMK path).
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Phase I Task 6 (item NN): newlib-nano printf/scanf. Per ESP-IDF's own Kconfig
# help text (components/newlib/Kconfig), this option "doesn't support 64-bit
# integer formats" (%llu/%lld) at all -- not just "needs the right specifier",
# contradicting the plan's original assumption. Verified (grep -rn "%ll"
# firmware/main/) that the only %llu specifier in the firmware
# (SerialAdapter.cpp's SIMULATE_MODE peer-dump line, printing the
# now-uint64_t PeerInfo::lastSeenMs) is compiled out entirely under the
# default SIMULATE_MODE=0 (project_config.h) -- so nano-format is safe for
# the default/production build. If a SIMULATE_MODE=1 debug build is ever
# combined with nano-format, that one debug line will render lastSeenMs
# incorrectly (cosmetic only -- not wire, not safety-relevant).
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
