# ESP-IDF default configuration for lattice-nodes firmware
# Approach: arduino-esp32 as IDF component (spec §Phase 0)

# Phase I Task 10 (item AAA): CONFIG_AUTOSTART_ARDUINO removed. This firmware
# now owns app_main() directly (firmware/main/main.cpp) instead of letting
# arduino-esp32's own app_main() call setup()/loop() on our behalf via its
# Arduino loop task. Per arduino-esp32's own Kconfig help text for
# AUTOSTART_ARDUINO ("If disabled, you can call initArduino() to run any
# preparations required by the framework"), app_main() calls initArduino()
# explicitly before anything that needs it (Logger.cpp's Serial-based
# logging, the sole remaining Arduino API user — see non-goals).
#
# CONFIG_ARDUINO_LOOP_STACK_SIZE (previously 4096, sized per Task 6's
# analysis for the old Arduino loop task) is gone with that task — the two
# FreeRTOS tasks that replace it (the Task 9 mesh-drain task and this task's
# housekeeping task) each size their own static stack directly in main.cpp
# (4096 B each, same budget as before).
CONFIG_FREERTOS_HZ=1000

# Flash: optimize for size + link-time optimization (Phase G §2, issue #52 lever 2).
# gc-sections + function-sections are ESP-IDF defaults already.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_LTO=y

# Partition table (no EEPROM partition — NVS replaces it)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: disabled — unused, saves ~10KB flash + heap
CONFIG_BT_ENABLED=n

# Phase J: E2E crypto back on mbedtls — libsodium reverted (measured +82KB in
# Phase I Task 2 vs the predicted win; ~22KB of it never-called primitives
# reachable only via sodium_init()'s dispatch tables — see
# docs/superpowers/specs/2026-08-06-phaseJ-crypto-revert-design.md).
# E2ECrypto.h/MeshCrypto.h/RouteMac.h now call mbedtls exclusively through
# lattice::crypto (firmware/main/src/crypto/Crypto.h). CHACHA20/POLY1305/
# CHACHAPOLY seal the E2E payloads, HKDF derives the direction-split keys,
# HARDWARE_SHA accelerates HMAC/HKDF (SHA-256 hardware block).
CONFIG_MBEDTLS_CHACHA20_C=y
CONFIG_MBEDTLS_POLY1305_C=y
CONFIG_MBEDTLS_CHACHAPOLY_C=y
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
# AES/GCM/CCM/TLS below are a SEPARATE, pre-existing Phase G/Phase A size trim
# (no TLS/HTTPS use at all, independent of which library E2E crypto calls).
# CONFIG_MBEDTLS_TLS_DISABLED=y (below) makes TLS_ENABLED=n real (spec
# docs/superpowers/specs/2026-08-07-mbedtls-tls-disable-design.md). NOTE:
# AES_C/ECDSA_C/CMAC_C/SECP256R1 remain force-selected =y by
# ESP_WIFI_MBEDTLS_CRYPTO (esp_wifi Kconfig, default y, also selected by
# WPA3 OWE_STA) — NOT the TLS chain as Phase J's earlier comment said;
# corrected here. Ending those selects is INFEASIBLE on this ESP-IDF
# version: AES_C can never be off (the port hardcodes MBEDTLS_CTR_DRBG_C,
# which requires it), and ESP_WIFI_MBEDTLS_CRYPTO=n fails at link
# ("undefined reference to sha1_vector" — wpa_supplicant's internal-crypto
# fallback is broken upstream). See the follow-up spec's final-outcome note.
CONFIG_MBEDTLS_AES_C=n
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_TLS_ENABLED=n
# TLS-disable follow-up: select the MBEDTLS_TLS_MODE choice's "None" option,
# ending the choice-default's TLS_SERVER/TLS_CLIENT -> TLS_ENABLED selects —
# this makes TLS_ENABLED=n above real (it was advisory before; see spec
# docs/superpowers/specs/2026-08-07-mbedtls-tls-disable-design.md).
CONFIG_MBEDTLS_TLS_DISABLED=y

# ESP-NOW and WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# NVS Flash
CONFIG_NVS_ENCRYPTION=n

# Task watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y

# Phase I Task 1: log + WiFi trim (item LL + audit XX-AAA)
CONFIG_LOG_DEFAULT_LEVEL_NONE=y

# ESP-NOW is our only WiFi use: no AP association, no aggregation, no persisted creds
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n

# LWIP: no sockets used; disable TCP + UDP if arduino-esp32 WiFi.mode allows it.
# NOTE: If Task 1 build fails with these, comment them out and leave a TODO to
# re-enable them at Task 3 (which replaces WiFi.mode with raw esp_netif_new).
CONFIG_LWIP_TCP_ENABLED=n
CONFIG_LWIP_UDP_ENABLED=n

# Phase I Task 2 follow-up: disable WiFi Enterprise to break the
# esp_wifi -> MBEDTLS_TLS_ENABLED force-select chain (no AP association in
# this firmware; pure ESP-NOW).
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Phase I Task 6 (item NN): newlib-nano printf/scanf. Per ESP-IDF's own Kconfig
# help text (components/newlib/Kconfig), this option "doesn't support 64-bit
# integer formats" (%llu/%lld) at all -- not just "needs the right specifier",
# contradicting the plan's original assumption. Verified (grep -rn "%ll"
# firmware/main/) that the only %llu specifier in the firmware
# (SerialAdapter.cpp's SIMULATE_MODE peer-dump line, printing the
# now-uint64_t PeerInfo::lastSeenMs) is compiled out entirely under the
# default SIMULATE_MODE=0 (project_config.h) -- so nano-format is safe for
# the default/production build. If a SIMULATE_MODE=1 debug build is ever
# combined with nano-format, that one debug line will render lastSeenMs
# incorrectly (cosmetic only -- not wire, not safety-relevant).
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y

# Phase I Task 9 (item EE): tickless idle + automatic dynamic frequency
# scaling. CONFIG_FREERTOS_HZ=1000 already set above (Task 6) — verified, not
# re-added. Paired with the esp_pm_configure(&pm_cfg) call in main.cpp's
# app_main() (Task 10 moved this to be the last call in app_main(), after
# both tasks are spawned; max 240MHz for master / pinned 80MHz for leaf nodes,
# min 80MHz, light sleep enabled): with tickless idle, the FreeRTOS idle task
# extends the tick period across idle stretches so the CPU can drop into
# light sleep between wake sources rather than waking every 1ms tick just to
# re-check "nothing to do".
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Phase J item KK (revived): only Curve25519 is used (X25519 E2E keys).
# ESP-IDF's default enables every NIST/Brainpool curve in mbedtls — dead
# flash here (nothing references them; note SECP256R1 + ECDSA_C get
# force-selected =y by ESP_WIFI_MBEDTLS_CRYPTO — see comment above — but
# their unreferenced code is stripped by LTO/gc-sections).
CONFIG_MBEDTLS_ECP_DP_SECP192R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP192K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP224K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE448_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_CURVE25519_ENABLED=y
# Nothing signs or verifies with ECDSA (no certs). Drop this single line if
# the build reports an unmet Kconfig dependency on it.
CONFIG_MBEDTLS_ECDSA_C=n
