# ESP-IDF default configuration for lattice-nodes firmware
# Approach: arduino-esp32 as IDF component (spec §Phase 0)

# Arduino-as-component: provides app_main() that calls setup()/loop()
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ARDUINO_LOOP_STACK_SIZE=8192

# Flash: optimize for size + link-time optimization (Phase G §2, issue #52 lever 2).
# gc-sections + function-sections are ESP-IDF defaults already.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_LTO=y

# Partition table (no EEPROM partition — NVS replaces it)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth: disabled — unused, saves ~10KB flash + heap
CONFIG_BT_ENABLED=n

# Phase I Task 2 (item GG): mbedtls fully dropped from E2E crypto — E2ECrypto.h,
# MeshCrypto.h, and RouteMac.h now call libsodium exclusively (see
# firmware/main/idf_component.yml's espressif/libsodium dependency), so the
# CHACHA20/POLY1305/CHACHAPOLY/HKDF/HARDWARE_SHA tuning that only existed for
# those call sites is gone. CONFIG_MBEDTLS_AES_C/GCM_C/CCM_C/HARDWARE_AES/
# TLS_ENABLED below are a SEPARATE, pre-existing Phase G/Phase A size trim
# (this node has no TLS/HTTPS use at all, independent of which library E2E
# crypto happens to call) — those stay =n. Measured: dropping them too (i.e.
# deleting this whole block, matching the Task 2 brief's Step 13 literally)
# silently re-enables mbedTLS's TLS stack + AES/GCM/CCM by falling back to
# ESP-IDF's default (=y for all five), a +82KB regression relative to the
# pre-Task-2 baseline (measured via a real mbedtls-linked build of this exact
# tree) that has nothing to do with this task's E2E-crypto swap — see task
# report.
CONFIG_MBEDTLS_AES_C=n
CONFIG_MBEDTLS_GCM_C=n
CONFIG_MBEDTLS_CCM_C=n
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_TLS_ENABLED=n

# ESP-NOW and WiFi
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# NVS Flash
CONFIG_NVS_ENCRYPTION=n

# Task watchdog
CONFIG_ESP_TASK_WDT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
